import { useCallback, useEffect, useRef, useState } from "react";
import { Canvas } from "@react-three/fiber";
import { ContactShadows, Environment, Lightformer } from "@react-three/drei";
import * as THREE from "three";

/* ------------------------------------------------------------------
 * Page content rendered to canvas textures so text stays attached
 * to the physical page during bending.
 * ------------------------------------------------------------------ */

type PageContent = {
  number: string;
  title: string;
  description: string;
};

const PAGE_CONTENT: PageContent[] = [
  {
    number: "01",
    title: "DISCOVER",
    description: "Find a challenge that makes you want to build.",
  },
  {
    number: "02",
    title: "TEAM UP",
    description: "Find people who share your ambition.",
  },
  {
    number: "03",
    title: "BUILD",
    description: "Turn your idea into something people can use.",
  },
  {
    number: "04",
    title: "SHIP",
    description: "Submit your work and take it to the arena.",
  },
];

/* ------------------------------------------------------------------
 * Helper: rounded rectangle path
 * ------------------------------------------------------------------ */

function roundRect(
  ctx: CanvasRenderingContext2D,
  x: number,
  y: number,
  w: number,
  h: number,
  r: number
): void {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

/* ------------------------------------------------------------------
 * Render page content to canvas texture
 * ------------------------------------------------------------------ */

function renderPageTexture(
  content: PageContent | null,
  isCover: boolean,
  _pageNumber: number,
  width = 1024,
  height = 1280
): THREE.CanvasTexture {
  const canvas = document.createElement("canvas");
  canvas.width = width;
  canvas.height = height;
  const ctx = canvas.getContext("2d");
  if (!ctx) {
    const tex = new THREE.CanvasTexture(canvas);
    tex.needsUpdate = true;
    return tex;
  }

  // Always white background (pure white for premium feel)
  ctx.fillStyle = "#FFFFFF";
  ctx.fillRect(0, 0, width, height);

  if (isCover) {
    // Outer page border (very subtle)
    ctx.strokeStyle = "#F0F0F0";
    ctx.lineWidth = 1;
    ctx.strokeRect(20, 20, width - 40, height - 40);

    // Inner border
    ctx.strokeStyle = "#E8E8E8";
    ctx.lineWidth = 1;
    ctx.strokeRect(35, 35, width - 70, height - 70);

    // CampusCode logo/title area - large centered
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    // Small "CAMPUSCODE" label at top
    ctx.fillStyle = "#888888";
    ctx.font = "400 12px 'DM Mono', monospace";
    ctx.textBaseline = "top";
    ctx.fillText("CAMPUSCODE", width / 2, 80);

    // Main logo mark - CC letters in black
    ctx.fillStyle = "#111111";
    ctx.font = "900 160px 'Inter', 'Helvetica Neue', Arial, sans-serif";
    ctx.textBaseline = "middle";
    ctx.fillText("CC", width / 2, height / 2 - 60);

    // Purple accent under logo
    ctx.fillStyle = "#7455FF";
    ctx.font = "600 22px 'Inter', 'Helvetica Neue', Arial, sans-serif";
    ctx.fillText("HACKATHON ARENA", width / 2, height / 2 + 30);

    // Thin purple line
    ctx.strokeStyle = "#7455FF";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(width / 2 - 80, height / 2 + 60);
    ctx.lineTo(width / 2 + 80, height / 2 + 60);
    ctx.stroke();

    // Bottom section
    ctx.fillStyle = "#AAAAAA";
    ctx.font = "400 10px 'DM Mono', monospace";
    ctx.textBaseline = "bottom";
    ctx.textAlign = "left";
    ctx.fillText("CAMPUSCODE · 2026", 60, height - 60);

    ctx.textAlign = "right";
    ctx.fillStyle = "#7455FF";
    ctx.font = "500 11px 'DM Mono', monospace";
    ctx.fillText("00", width - 60, height - 60);
  } else if (content) {
    // ===== INTERIOR PAGE LAYOUT =====

    // Top header bar
    ctx.fillStyle = "#F8F8F8";
    ctx.fillRect(0, 0, width, 100);

    // Top running header text
    ctx.fillStyle = "#AAAAAA";
    ctx.font = "400 9px 'DM Mono', monospace";
    ctx.textBaseline = "top";
    ctx.textAlign = "left";
    ctx.fillText("CAMPUSCODE · HOW IT WORKS", 60, 32);

    // Page number (purple, top right)
    ctx.fillStyle = "#7455FF";
    ctx.font = "600 14px 'DM Mono', monospace";
    ctx.textAlign = "right";
    ctx.fillText(content.number, width - 60, 30);

    // Thin rule under header
    ctx.strokeStyle = "#E0E0E0";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(60, 95);
    ctx.lineTo(width - 60, 95);
    ctx.stroke();

    // Purple accent line
    ctx.strokeStyle = "#7455FF";
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(60, 115);
    ctx.lineTo(200, 115);
    ctx.stroke();

    // Step number and title
    ctx.fillStyle = "#7455FF";
    ctx.font = "500 16px 'DM Mono', monospace";
    ctx.textBaseline = "top";
    ctx.textAlign = "left";
    ctx.fillText(content.number, 60, 145);

    ctx.fillStyle = "#111111";
    ctx.font = "900 96px 'Inter', 'Helvetica Neue', Arial, sans-serif";
    ctx.fillText(content.title, 60, 175);

    // Description
    ctx.fillStyle = "#666666";
    ctx.font = "400 20px 'Inter', 'Helvetica Neue', Arial, sans-serif";
    ctx.fillText(content.description, 60, 290);

    // Divider
    ctx.strokeStyle = "#DEDED8";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(60, 340);
    ctx.lineTo(width - 60, 340);
    ctx.stroke();

    // UI mockup area
    const mockupY = 380;

    if (content.title === "DISCOVER") {
      drawDiscoverMockup(ctx, mockupY);
    } else if (content.title === "TEAM UP") {
      drawTeamMockup(ctx, mockupY);
    } else if (content.title === "BUILD") {
      drawBuildMockup(ctx, mockupY);
    } else if (content.title === "SHIP") {
      drawShipMockup(ctx, mockupY);
    }

    // Bottom section
    ctx.strokeStyle = "#7455FF";
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(width - 200, height - 110);
    ctx.lineTo(width - 60, height - 110);
    ctx.stroke();

    // Footer
    ctx.fillStyle = "#AAAAAA";
    ctx.font = "400 9px 'DM Mono', monospace";
    ctx.textBaseline = "bottom";
    ctx.textAlign = "left";
    ctx.fillText("CAMPUSCODE · 2026", 60, height - 55);

    ctx.fillStyle = "#7455FF";
    ctx.font = "500 11px 'DM Mono', monospace";
    ctx.textAlign = "right";
    ctx.fillText(content.number, width - 60, height - 55);
  }

  const texture = new THREE.CanvasTexture(canvas);
  texture.needsUpdate = true;
  texture.anisotropy = 4;
  return texture;
}

/* ------------------------------------------------------------------
 * Mockup drawing functions
 * ------------------------------------------------------------------ */

function drawDiscoverMockup(
  ctx: CanvasRenderingContext2D,
  y: number
) {
  const cardW = 220;
  const cardH = 140;
  const gap = 20;
  const startX = 60;

  // Main hackathon card
  ctx.fillStyle = "#FAFAFA";
  roundRect(ctx, startX, y, cardW, cardH, 6);
  ctx.fill();
  ctx.strokeStyle = "#E0E0E0";
  ctx.lineWidth = 1;
  roundRect(ctx, startX, y, cardW, cardH, 6);
  ctx.stroke();

  // Event category tag
  ctx.fillStyle = "#7455FF";
  roundRect(ctx, startX + 15, y + 14, 90, 18, 3);
  ctx.fill();
  ctx.fillStyle = "#FFFFFF";
  ctx.font = "500 9px 'DM Mono', monospace";
  ctx.textBaseline = "middle";
  ctx.textAlign = "center";
  ctx.fillText("AI INNOVATION", startX + 60, y + 22);

  // Event title
  ctx.fillStyle = "#111111";
  ctx.font = "700 18px 'Inter', 'Helvetica Neue', Arial, sans-serif";
  ctx.textBaseline = "top";
  ctx.textAlign = "left";
  ctx.fillText("AI Innovation Challenge", startX + 15, y + 40);

  // Date and participants
  ctx.fillStyle = "#888888";
  ctx.font = "400 10px 'DM Mono', monospace";
  ctx.fillText("Mar 15-17 · 248 participants", startX + 15, y + 64);

  // Mini event preview (visual)
  ctx.fillStyle = "#E8E8E8";
  ctx.fillRect(startX + 15, y + 85, 190, 3);
  ctx.fillStyle = "#F5F5F5";
  ctx.fillRect(startX + 15, y + 95, 190, 3);
  ctx.fillStyle = "#EDEDED";
  ctx.fillRect(startX + 15, y + 105, 140, 3);

  // Second card
  const card2X = startX + cardW + gap;
  ctx.fillStyle = "#FAFAFA";
  roundRect(ctx, card2X, y, 180, cardH, 6);
  ctx.fill();
  ctx.strokeStyle = "#E0E0E0";
  ctx.lineWidth = 1;
  roundRect(ctx, card2X, y, 180, cardH, 6);
  ctx.stroke();

  ctx.fillStyle = "#7455FF";
  roundRect(ctx, card2X + 12, y + 14, 70, 18, 3);
  ctx.fill();
  ctx.fillStyle = "#FFFFFF";
  ctx.font = "500 8px 'DM Mono', monospace";
  ctx.textBaseline = "middle";
  ctx.textAlign = "center";
  ctx.fillText("WEB DEV", card2X + 47, y + 22);

  ctx.fillStyle = "#111111";
  ctx.font = "700 15px 'Inter', 'Helvetica Neue', Arial, sans-serif";
  ctx.textBaseline = "top";
  ctx.fillText("Future Web", card2X + 12, y + 40);

  ctx.fillStyle = "#888888";
  ctx.font = "400 9px 'DM Mono', monospace";
  ctx.fillText("Apr 5-7 · 186 participants", card2X + 12, y + 60);

  ctx.fillStyle = "#E8E8E8";
  ctx.fillRect(card2X + 12, y + 80, 156, 3);
  ctx.fillStyle = "#F5F5F5";
  ctx.fillRect(card2X + 12, y + 90, 156, 3);
}

function drawTeamMockup(
  ctx: CanvasRenderingContext2D,
  y: number
) {
  const startX = 60;
  const avatarSize = 56;
  const gap = 20;

  // Three team member avatars with names
  const members = [
    { initials: "PS", name: "Priya S.", role: "Full Stack", color: "#7455FF" },
    { initials: "MK", name: "Marcus K.", role: "AI/ML", color: "#82B91A" },
    { initials: "AR", name: "Ayesha R.", role: "Design", color: "#FF6B6B" },
  ];

  members.forEach((member, i) => {
    const x = startX + i * (avatarSize + gap);

    // Avatar circle
    ctx.fillStyle = member.color;
    ctx.beginPath();
    ctx.arc(x + avatarSize / 2, y + avatarSize / 2, avatarSize / 2 - 3, 0, Math.PI * 2);
    ctx.fill();

    // Initials
    ctx.fillStyle = "#FFFFFF";
    ctx.font = "700 20px 'Inter', 'Helvetica Neue', Arial, sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(member.initials, x + avatarSize / 2, y + avatarSize / 2);

    // Name
    ctx.fillStyle = "#111111";
    ctx.font = "600 12px 'Inter', 'Helvetica Neue', Arial, sans-serif";
    ctx.textBaseline = "top";
    ctx.fillText(member.name, x + 4, y + avatarSize + 8);

    // Role
    ctx.fillStyle = "#888888";
    ctx.font = "400 9px 'DM Mono', monospace";
    ctx.fillText(member.role, x + 4, y + avatarSize + 26);
  });

  // Connection lines between avatars
  ctx.strokeStyle = "#E0E0E0";
  ctx.lineWidth = 1;
  ctx.setLineDash([3, 3]);
  for (let i = 0; i < members.length - 1; i++) {
    const x1 = startX + i * (avatarSize + gap) + avatarSize;
    const y1 = y + avatarSize / 2;
    const x2 = startX + (i + 1) * (avatarSize + gap);
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y1);
    ctx.stroke();
  }
  ctx.setLineDash([]);

  // Team stats card
  const cardX = startX + avatarSize * 3 + gap * 2;
  const cardW = 200;
  const cardH = 130;

  ctx.fillStyle = "#FAFAFA";
  roundRect(ctx, cardX, y, cardW, cardH, 6);
  ctx.fill();
  ctx.strokeStyle = "#E0E0E0";
  ctx.lineWidth = 1;
  roundRect(ctx, cardX, y, cardW, cardH, 6);
  ctx.stroke();

  ctx.fillStyle = "#111111";
  ctx.font = "700 14px 'Inter', 'Helvetica Neue', Arial, sans-serif";
  ctx.textBaseline = "top";
  ctx.textAlign = "left";
  ctx.fillText("Team Workspace", cardX + 15, y + 15);

  ctx.fillStyle = "#888888";
  ctx.font = "400 10px 'DM Mono', monospace";
  ctx.fillText("3 members active now", cardX + 15, y + 36);

  // Repo list
  const repos = ["campus-app", "ml-engine", "design-ui"];
  repos.forEach((repo, i) => {
    ctx.fillStyle = "#7455FF";
    ctx.fillRect(cardX + 15, y + 58 + i * 18, 6, 6);
    ctx.fillStyle = "#666666";
    ctx.font = "400 10px 'DM Mono', monospace";
    ctx.fillText(repo, cardX + 28, y + 58 + i * 18 + 3);
  });
}

function drawBuildMockup(
  ctx: CanvasRenderingContext2D,
  y: number
) {
  const startX = 60;
  const editorW = 280;
  const editorH = 160;

  // Code editor window
  ctx.fillStyle = "#1a1a1a";
  roundRect(ctx, startX, y, editorW, editorH, 6);
  ctx.fill();

  // Title bar
  ctx.fillStyle = "#2a2a2a";
  roundRect(ctx, startX + 4, y + 4, editorW - 8, 28, 4);
  ctx.fill();

  // Window buttons
  ["#FF6B6B", "#FFBD4A", "#4ECDC4"].forEach((color, i) => {
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.arc(startX + 16 + i * 16, y + 18, 4, 0, Math.PI * 2);
    ctx.fill();
  });

  // Code lines
  const code = [
    "import { CampusCode } from '@campus/code'",
    "",
    "const app = new CampusCode({",
    '  project: "hackathon-app",',
    '  team: "dev-team-01",',
    "})",
    "",
    "app.deploy();",
  ];

  ctx.fillStyle = "#666666";
  ctx.font = "400 10px 'DM Mono', monospace";
  ctx.textBaseline = "top";
  code.forEach((line, i) => {
    ctx.fillText(line, startX + 14, y + 44 + i * 13);
  });

  // AI assistant badge
  ctx.fillStyle = "#7455FF";
  roundRect(ctx, startX + editorW - 105, y + 38, 90, 20, 3);
  ctx.fill();
  ctx.fillStyle = "#FFFFFF";
  ctx.font = "600 9px 'DM Mono', monospace";
  ctx.textAlign = "center";
  ctx.fillText("AI ASSISTANT", startX + editorW - 57, y + 47);

  // App preview window
  const previewX = startX + editorW + 25;
  const previewW = 240;
  const previewH = 160;

  ctx.fillStyle = "#FAFAFA";
  roundRect(ctx, previewX, y, previewW, previewH, 6);
  ctx.fill();
  ctx.strokeStyle = "#E0E0E0";
  ctx.lineWidth = 1;
  roundRect(ctx, previewX, y, previewW, previewH, 6);
  ctx.stroke();

  // App content
  ctx.fillStyle = "#FFFFFF";
  roundRect(ctx, previewX + 16, y + 16, previewW - 32, previewH - 48, 3);
  ctx.fill();

  // App header
  ctx.fillStyle = "#111111";
  ctx.font = "700 14px 'Inter', 'Helvetica Neue', Arial, sans-serif";
  ctx.textBaseline = "top";
  ctx.textAlign = "left";
  ctx.fillText("CampusCode App", previewX + 26, y + 26);

  // UI elements
  ctx.fillStyle = "#F0F0F0";
  ctx.fillRect(previewX + 26, y + 50, 208, 4);

  ctx.fillStyle = "#7455FF";
  ctx.fillRect(previewX + 26, y + 65, 208, 28);
  ctx.fillStyle = "#FFFFFF";
  ctx.font = "600 10px 'DM Mono', monospace";
  ctx.textAlign = "center";
  ctx.fillText("BUILD PROJECT", previewX + 104, y + 74);

  // Stats
  ctx.fillStyle = "#E8E8E8";
  ctx.fillRect(previewX + 26, y + 105, 60, 16);
  ctx.fillRect(previewX + 92, y + 105, 60, 16);
  ctx.fillRect(previewX + 158, y + 105, 60, 16);

  ctx.fillStyle = "#888888";
  ctx.font = "400 8px 'DM Mono', monospace";
  ctx.textAlign = "center";
  ctx.fillText("12 issues", previewX + 56, y + 110);
  ctx.fillText("8 solved", previewX + 122, y + 110);
  ctx.fillText("4 tests", previewX + 188, y + 110);
}

function drawShipMockup(
  ctx: CanvasRenderingContext2D,
  y: number
) {
  const startX = 60;
  const cardW = 320;
  const cardH = 150;

  // Main submission card
  ctx.fillStyle = "#FAFAFA";
  roundRect(ctx, startX, y, cardW, cardH, 8);
  ctx.fill();
  ctx.strokeStyle = "#E0E0E0";
  ctx.lineWidth = 1;
  roundRect(ctx, startX, y, cardW, cardH, 8);
  ctx.stroke();

  // Trophy/achievement icon area
  ctx.fillStyle = "#7455FF";
  ctx.beginPath();
  ctx.moveTo(startX + cardW / 2 - 20, y + 25);
  ctx.lineTo(startX + cardW / 2 + 20, y + 25);
  ctx.lineTo(startX + cardW / 2 + 10, y + 50);
  ctx.lineTo(startX + cardW / 2, y + 65);
  ctx.lineTo(startX + cardW / 2 - 10, y + 50);
  ctx.closePath();
  ctx.fill();

  // Star/achievement
  ctx.fillStyle = "#FFFFFF";
  ctx.font = "700 26px 'Inter', 'Helvetica Neue', Arial, sans-serif";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("\u2605", startX + cardW / 2, y + 48);

  // Title
  ctx.fillStyle = "#111111";
  ctx.font = "800 22px 'Inter', 'Helvetica Neue', Arial, sans-serif";
  ctx.textBaseline = "top";
  ctx.textAlign = "left";
  ctx.fillText("Ready to Ship", startX + 20, y + 80);

  // Status text
  ctx.fillStyle = "#666666";
  ctx.font = "400 12px 'Inter', 'Helvetica Neue', Arial, sans-serif";
  ctx.fillText("Your project is complete and ready for the arena.", startX + 20, y + 108);

  // Submit button
  ctx.fillStyle = "#111111";
  roundRect(ctx, startX + 20, y + 125, cardW - 40, 22, 4);
  ctx.fill();
  ctx.fillStyle = "#FFFFFF";
  ctx.font = "600 10px 'DM Mono', monospace";
  ctx.textAlign = "center";
  ctx.fillText("SUBMIT TO ARENA  \u2192", startX + cardW / 2, y + 133);

  // Status indicators (right side)
  const statuses = [
    { label: "Build", passed: true },
    { label: "Tests", passed: true },
    { label: "Review", passed: false },
  ];

  statuses.forEach((status, i) => {
    const x = startX + cardW + 25 + i * 75;
    const statusY = y + 8;

    // Status circle
    ctx.fillStyle = status.passed ? "#82B91A" : "#FFBD4A";
    ctx.beginPath();
    ctx.arc(x + 10, statusY + 10, 9, 0, Math.PI * 2);
    ctx.fill();

    // Checkmark or clock
    ctx.fillStyle = "#FFFFFF";
    ctx.font = "700 12px 'Inter', 'Helvetica Neue', Arial, sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(status.passed ? "\u2713" : "\u2026", x + 10, statusY + 11);

    // Label
    ctx.fillStyle = "#666666";
    ctx.font = "400 9px 'DM Mono', monospace";
    ctx.textBaseline = "top";
    ctx.fillText(status.label, x - 2, statusY + 24);
  });
}

/* ------------------------------------------------------------------
 * Book geometry constants
 * ------------------------------------------------------------------ */

const PAGE_WIDTH = 1.7;
const PAGE_HEIGHT = 2.2;
const PAGE_THICKNESS = 0.016;
const SPINE_WIDTH = 0.1;

// Shared geometry references (created once)
const coverGeoRef = { current: null as THREE.PlaneGeometry | null };
const pageGeoRef = { current: null as THREE.PlaneGeometry | null };

/* ------------------------------------------------------------------
 * Types
 * ------------------------------------------------------------------ */

interface BookState {
  page: number;
  turning: boolean;
  progress: number;
}

interface BookController {
  state: BookState;
  setState: React.Dispatch<React.SetStateAction<BookState>>;
  requestTurn: (direction: "forward" | "backward") => void;
}

interface PageMesh {
  mesh: THREE.Mesh;
  index: number;
  restingX: number;
}

/* ------------------------------------------------------------------
 * BookScene - renders the 3D book with all pages
 * ------------------------------------------------------------------ */

function BookScene({ controller }: { controller: BookController }) {
  const groupRef = useRef<THREE.Group>(null);
  const [pages, setPages] = useState<PageMesh[]>([]);
  const initializedRef = useRef(false);

  // Initialize pages once
  useEffect(() => {
    if (!groupRef.current || initializedRef.current || pages.length > 0) return;
    initializedRef.current = true;
    if (!coverGeoRef.current) {
      coverGeoRef.current = new THREE.PlaneGeometry(PAGE_WIDTH, PAGE_HEIGHT, 32, 32);
      pageGeoRef.current = new THREE.PlaneGeometry(PAGE_WIDTH, PAGE_HEIGHT, 32, 32);
    }

    const newPages: PageMesh[] = [];

    // Create cover page (index 0) - white cover with subtle border
    const coverTexture = renderPageTexture(null, true, 0);
    const coverMat = new THREE.MeshStandardMaterial({
      map: coverTexture,
      side: THREE.DoubleSide,
      roughness: 0.35,
      metalness: 0.02,
    });
    const cover = new THREE.Mesh(coverGeoRef.current.clone(), coverMat);
    const coverRestingX = PAGE_WIDTH / 2 + SPINE_WIDTH / 2 + 0.008;
    cover.position.set(coverRestingX, 0, 0);
    // Slightly thicker appearance for cover
    cover.scale.z = 1.3;
    groupRef.current.add(cover);
    newPages.push({
      mesh: cover,
      index: 0,
      restingX: coverRestingX,
    });

    // Create interior pages (indices 1-4)
    PAGE_CONTENT.forEach((content, i) => {
      const texture = renderPageTexture(content, false, i + 1);
      const mat = new THREE.MeshStandardMaterial({
        map: texture,
        side: THREE.DoubleSide,
        roughness: 0.5,
        metalness: 0.0,
      });
      const page = new THREE.Mesh(pageGeoRef.current!, mat);
      const restingX = PAGE_WIDTH / 2 - (i + 1) * (PAGE_THICKNESS + 0.003);
      page.position.set(restingX, 0, 0);
      groupRef.current!.add(page);
      newPages.push({
        mesh: page,
        index: i + 1,
        restingX,
      });
    });

    setPages(newPages);
  }, []);

  // Update page positions based on turn state
  useEffect(() => {
    const { page, turning, progress } = controller.state;
    if (!turning || pages.length === 0) {
      // Reset all pages to resting positions
      pages.forEach(({ mesh, restingX }) => {
        mesh.position.x = restingX;
        mesh.position.y = 0;
        mesh.position.z = 0;
        mesh.rotation.set(0, 0, 0);
      });
      return;
    }

    const halfW = PAGE_WIDTH / 2;
    const eased = easeInOutCubic(progress);

    // Move the turning page (the page being turned)
    const turningIdx = page; // page 1-4 are interior pages being turned
    const turningPage = pages.find((p) => p.index === turningIdx);

    if (turningPage && turningIdx > 0 && turningIdx <= 4) {
      // Page turn animation: lift from right edge, curl toward left, land on left
      const curlHeight = Math.sin(eased * Math.PI) * 0.35;
      const zOffset = Math.sin(eased * Math.PI) * 0.12;

      turningPage.mesh.position.set(
        halfW - eased * (PAGE_WIDTH + SPINE_WIDTH + 0.15),
        curlHeight,
        zOffset
      );
      // Full rotation around Y axis to flip the page
      turningPage.mesh.rotation.y = eased * Math.PI;
    }

    // Adjust neighboring pages for realistic stacking
    pages.forEach(({ mesh, index, restingX }) => {
      if (index === turningIdx) return; // Already handled above
      if (index < turningIdx) {
        // Pages to the left of turning page (already revealed) - slight movement
        mesh.position.x = restingX;
        mesh.position.y = 0;
        mesh.position.z = 0;
      } else if (index > turningIdx) {
        // Pages to the right (not yet revealed) - stack correctly
        mesh.position.x = restingX + eased * PAGE_THICKNESS * 0.3;
        mesh.position.y = 0;
        mesh.position.z = 0;
      }
    });
  }, [controller.state, pages]);

  return (
    <group ref={groupRef}>
      {/* Paper edge detail - visible thickness on the right side */}
      {Array.from({ length: 4 }).map((_, i) => (
        <mesh
          key={`edge-${i}`}
          position={[
            PAGE_WIDTH / 2 - (i + 0.5) * PAGE_THICKNESS - 0.005,
            0,
            0,
          ]}
          rotation={[0, 0, Math.PI / 2]}
        >
          <boxGeometry args={[0.003, PAGE_HEIGHT - 0.02, PAGE_THICKNESS + 0.004]} />
          <meshStandardMaterial
            color={i === 0 ? "#F0F0F0" : "#EBEBEB"}
            roughness={0.7}
            metalness={0}
          />
        </mesh>
      ))}

      {/* Spine */}
      <mesh position={[-PAGE_WIDTH / 2 + SPINE_WIDTH / 2, 0, 0]}>
        <cylinderGeometry args={[SPINE_WIDTH / 2, SPINE_WIDTH / 2, PAGE_HEIGHT - 0.04, 16]} />
        <meshStandardMaterial color="#F5F5F5" roughness={0.8} metalness={0} />
      </mesh>

      {/* Contact shadow beneath book */}
      <ContactShadows
        position={[0, -PAGE_HEIGHT / 2 - 0.015, 0]}
        opacity={0.22}
        scale={4.5}
        blur={3.5}
        far={2.5}
        resolution={512}
        color="#333333"
      />
    </group>
  );
}

function easeInOutCubic(x: number): number {
  return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
}

/* ------------------------------------------------------------------
 * PageFlipBook - main component with interaction handling
 * ------------------------------------------------------------------ */

export function PageFlipBook() {
  const [state, setState] = useState<BookState>({ page: 0, turning: false, progress: 0 });
  const sceneRef = useRef<HTMLDivElement>(null);
  const turnCooldown = useRef<number>(0);
  const lastWheelTime = useRef<number>(0);

  const requestTurn = useCallback(
    (direction: "forward" | "backward") => {
      const now = Date.now();
      // Cooldown prevents rapid double-triggers from trackpad
      if (now - turnCooldown.current < 400) return;
      if (state.turning) return;

      let newPage = state.page;
      if (direction === "forward" && state.page < 4) {
        newPage = state.page + 1;
      } else if (direction === "backward" && state.page > 0) {
        newPage = state.page - 1;
      } else {
        return;
      }

      turnCooldown.current = now;
      setState({ page: newPage, turning: true, progress: 0 });
    },
    [state.page, state.turning]
  );

  // Animate turn progress
  useEffect(() => {
    if (!state.turning) return;

    let startTime: number | null = null;
    let animFrame: number;

    const animate = (timestamp: number) => {
      if (!startTime) startTime = timestamp;
      const elapsed = (timestamp - startTime) / 1000;
      const duration = 0.65; // 650ms per page turn
      const progress = Math.min(1, elapsed / duration);

      setState((prev) => ({ ...prev, progress }));

      if (progress < 1) {
        animFrame = requestAnimationFrame(animate);
      } else {
        setState((prev) => ({ ...prev, turning: false, progress: 0 }));
      }
    };

    animFrame = requestAnimationFrame(animate);
    return () => cancelAnimationFrame(animFrame);
  }, [state.turning]);

  // Wheel handler with gesture threshold
  const handleWheel = useCallback(
    (e: WheelEvent) => {
      if (state.turning) return;

      const now = Date.now();
      if (now - lastWheelTime.current < 150) return; // Debounce rapid wheel events
      lastWheelTime.current = now;

      // Ignore tiny movements (trackpad jitter)
      if (Math.abs(e.deltaY) < 15) return;

      const direction = e.deltaY > 0 ? "forward" : "backward";
      requestTurn(direction);
    },
    [state.turning, requestTurn]
  );

  // Click handler
  const handleClick = useCallback(() => {
    requestTurn("forward");
  }, [requestTurn]);

  // Touch/drag handling for mobile
  const handleTouchStart = useCallback((startX: number) => {
    (sceneRef.current as any).touchStartX = startX;
    (sceneRef.current as any).touchStartTime = Date.now();
  }, []);

  const handleTouchEnd = useCallback(
    (clientX: number) => {
      const startX = (sceneRef.current as any)?.touchStartX;
      const startTime = (sceneRef.current as any)?.touchStartTime;
      if (startX === undefined || startTime === undefined) return;

      const deltaX = clientX - startX;
      const elapsed = Date.now() - startTime;

      // Swipe gesture: horizontal drag > 50px within 400ms
      if (Math.abs(deltaX) > 50 && elapsed < 400 && !state.turning) {
        requestTurn(deltaX > 0 ? "forward" : "backward");
      }
    },
    [state.turning, requestTurn]
  );

  return (
    <div
      className="book-container"
      onWheel={handleWheel as unknown as React.WheelEventHandler<HTMLDivElement>}
      onTouchStart={(e) => handleTouchStart(e.touches[0].clientX)}
      onTouchEnd={(e) => handleTouchEnd(e.changedTouches[0].clientX)}
    >
      <div className="book-scene-wrapper" ref={sceneRef}>
        <Canvas
          shadows
          dpr={[1, 1.5]}
          camera={{ position: [0, 0.3, 4.8], fov: 35 }}
          gl={{ antialias: true, alpha: true }}
          onClick={handleClick}
          style={{ background: "#FFFFFF" }}
        >
          <color attach="background" args={["#FFFFFF"]} />
          <ambientLight intensity={0.55} />
          <directionalLight
            position={[5, 6, 5]}
            intensity={2.6}
            color="#FFFFFF"
            castShadow
            shadow-mapSize={[1024, 1024]}
          />
          <directionalLight position={[-3, 4, 3]} intensity={0.6} color="#EAEAFF" />
          <directionalLight position={[0, -2, 4]} intensity={0.4} color="#FFFFFF" />

          <Environment resolution={64} frames={1}>
            <Lightformer
              intensity={4}
              position={[0, 4, 2]}
              scale={[8, 8, 1]}
              color="#FFFFFF"
            />
            <Lightformer
              intensity={2}
              position={[-3, 2, 3]}
              scale={[4, 4, 1]}
              color="#EAEAFF"
            />
          </Environment>

          <BookScene controller={{ state, setState, requestTurn }} />
        </Canvas>
      </div>

      {/* Progress indicator */}
      <div className="book-progress" role="tablist" aria-label="Book pages">
        {["CLOSED", "DISCOVER", "TEAM UP", "BUILD", "SHIP"].map((label, i) => (
          <button
            key={i}
            className={`progress-step ${i <= state.page ? "active" : ""}`}
            role="tab"
            aria-selected={i === state.page}
            aria-label={`Page ${i + 1}: ${label}`}
            onClick={() => {
              if (i < state.page) {
                requestTurn("backward");
              } else if (i === state.page + 1) {
                requestTurn("forward");
              }
            }}
          >
            <span className="progress-dot" />
            <span className="progress-label">{label}</span>
          </button>
        ))}
      </div>

      {/* Instructions */}
      <div className="book-instructions">
        {state.page === 0 && !state.turning && (
          <p className="scroll-hint">SCROLL TO OPEN</p>
        )}
        {state.turning && (
          <p className="turning-hint">Turning page...</p>
        )}
        {state.page === 4 && !state.turning && (
          <p className="end-hint">
            Scroll up to go back, or continue scrolling to next section
          </p>
        )}
      </div>
    </div>
  );
}

export default PageFlipBook;
